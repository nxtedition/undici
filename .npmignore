*
!lib/**/*
!index.js
!index.d.ts

# milo's src/*/index.js embed the wasm files as base64 strings; the unbundled
# entry points that read them are not used
lib/milo/binary
lib/milo/src/*/unbundled.js

# File generated by /test/request-timeout.js
test/request-timeout.10mb.bin

# AI agent private workspaces (.codex-private, .claude-private, ...)
.claude
.*-private/
